# LLM Provider configuration (Session 2 — kept for backwards compatibility)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai

# Default model for the configured provider. Can be overridden per request via
# the "model" field in POST /api/v1/estimate (handy for live A/B comparisons
# without restarting the server).
LLM_MODEL=gpt-4o-mini

# Application
APP_ENV=development
LOG_LEVEL=DEBUG

# --- Session 3 — LiteLLM wrapper ----------------------------------------------
# The wrapper tries PRIMARY_MODEL first and falls back to FALLBACK_MODEL on
# failure, with up to LLM_RETRIES attempts and an LLM_TIMEOUT-second deadline.
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001

# --- Session 7 live: runtime model switching + chunking-strategy models ---
# PRIMARY_MODEL / FALLBACK_MODEL / CRITIC_MODEL / METADATA_EXTRACTOR_MODEL /
# COMPRESSION_MODEL plus the two below can be overridden at runtime via
# PUT /api/v1/config/models (Redis-backed; no restart needed). .env stays the
# layer of DEFAULTS. EMBEDDING_MODEL is deliberately NOT runtime-switchable
# (changing it would invalidate every stored vector).
# Model that decomposes a component into atomic propositions (propositional chunker).
PROPOSITIONAL_CHUNKER_MODEL=gpt-4o-mini
# Claude model that situates each chunk in its parent budget (contextual retrieval).
CONTEXTUAL_CHUNKER_MODEL=claude-sonnet-4-5
LLM_TIMEOUT=30
LLM_RETRIES=2

# --- Session 3 — Redis exact-match cache --------------------------------------
# Inside docker-compose, REDIS_URL is overridden to redis://redis:6379.
# When running uvicorn locally (outside Docker), use redis://localhost:6379.
REDIS_URL=redis://redis:6379
CACHE_TTL=86400

# --- Session 3 — Streamlit transport ------------------------------------------
# Streamlit hits the FastAPI service over HTTP. Point this to wherever the
# estimator is reachable from the machine running streamlit_app.py.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Session 4 — Semantic cache (redisvl + embeddings) ------------------------
# Cosine similarity threshold (0..1) above which a stored estimation is served
# as a cache hit. 0.92 is conservative; lower threshold = more recall, more
# false positives. Affines with the chosen embedding model.
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
# When true, the cache logs would-be hits but does NOT serve them — useful to
# calibrate the threshold against production traffic before flipping on.
SEMANTIC_CACHE_LOG_ONLY=false

# --- Persistence (Postgres) ---------------------------------------------------
# Inside docker-compose, DATABASE_URL is overridden to point at the postgres
# service (postgres:5432). For local uvicorn, run Postgres locally or adjust.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/estimator

# --- Session 6 (CAG stress test) ---------------------------------------------
# Enforce the business rule "per-phase costs must sum to total_cost_eur".
# Keep true in normal operation. The stress runner sets it false because
# gpt-4o-mini cannot reliably make the two match and the retries 502 the run.
ENFORCE_PHASES_SUM=true

# --- Session 6 live (Ingestion + PII) -----------------------------------------
# DATABASE_URL above is reused. The compose image is pgvector/pgvector:pg16 so
# Session 7 can enable the vector extension via a migration; no extension is
# activated yet. The two new tables (pseudonym_mappings, ingestion_jobs) are
# created by ``alembic upgrade head`` (run on container startup).
#
# Path to the data-source catalog (YAML). Loaded once at startup, validated
# with Pydantic. ``include`` decisions drive the ingestion endpoint.
CATALOG_PATH=data/catalog/catalog.yaml
# Root folder the catalog ``location`` entries are resolved against.
INGESTION_DATA_ROOT=data/seed
# spaCy model Presidio uses to detect PERSON/LOC. Without an explicit Spanish
# model Presidio defaults to English and SILENTLY misses Hispanic names.
# Install once: uv run python -m spacy download es_core_news_md
PRESIDIO_SPACY_MODEL=es_core_news_md
# Faker locale for generating pseudonyms (names, emails, …).
PSEUDONYM_FAKER_LOCALE=es_ES
# HMAC salt used to derive the original_hash stored in pseudonym_mappings.
# Rotating it invalidates all prior mappings — the GDPR Art. 17 lever. CHANGE IN PROD.
PSEUDONYM_HASH_SALT=change-me-in-prod

# --- Session 9 — RAG estimation (transcript → grounded estimate) --------------
# Two independent API keys protect the two new routers. Sent by clients in the
# X-API-Key header. These DEMO values MUST MATCH estimator-web/.env so the RAG
# wizard authenticates; leave blank to disable a router (every request → 401).
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key

# Models for the RAG pipeline (both go through LLMWrapper / Instructor). The
# reformulator distills the transcript; the generator reasons over retrieved
# budgets with medium reasoning effort. Switchable at runtime via the Ajustes UI.
REFORMULATION_MODEL=gpt-5-mini
GENERATION_MODEL=gpt-5
# "high" drives a deeper module→task decomposition (granular modular breakdown).
# The S09 article used "medium"; lower it back if you want the article's value.
GENERATION_REASONING_EFFORT=high
# Token ceiling (reasoning + output) for the RAG structured calls. gpt-5 spends
# reasoning tokens against this budget, so the 4000 wrapper default truncates
# the JSON (finish_reason='length' → 502). 64000 leaves room for high-effort
# reasoning + the larger nested (modules→tasks) output. A cap, not a target —
# costs nothing extra unless the model uses it. Changing it needs a recreate.
GENERATION_MAX_TOKENS=64000

# Retrieval knobs (locked defaults).
RETRIEVAL_TOP_K=10
RETRIEVAL_DISTANCE_THRESHOLD=0.6

# Token budget for the assembled <source> context block (tiktoken cl100k_base).
MAX_CONTEXT_TOKENS=16384

# Idempotency cache TTL (seconds) for POST /v1/estimate/from-transcript. Uses
# REDIS_URL when set; otherwise an in-process dict fallback.
IDEMPOTENCY_TTL=86400

# --- Session 10 — hybrid search + cross-encoder reranking ---------------------
# Defaults for the retrieval mode and reranking. The pipeline falls back to these
# when a caller passes search_mode/rerank = None, so flipping them changes the
# default behaviour without touching code (exercise step 3). The eval script runs
# all four configs (A/B/C/D) regardless of these defaults.
# "vector" + off = the Session 8 baseline (config A in the measurement).
RETRIEVAL_SEARCH_MODE=vector
RERANKER_ENABLED=false
# Multilingual cross-encoder. First use downloads the weights (~450MB) from the
# HuggingFace hub; verify with `python -m app.generation.rag.retrieval.verify_reranker`.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Recall-then-rerank widths: recall this many candidates, rerank down to top-N.
RETRIEVAL_RECALL_TOP_K=50
RERANK_TOP_N=5
# RRF smoothing constant for fusing the vector + lexical rankings.
RRF_K=60

# --- Session 13 — LangGraph estimation graph + Logfire observability ----------
# The estimation flow re-expressed as a StateGraph (app/domain/graph). Its
# structured-output nodes go through LLMWrapper. Both are in AVAILABLE_MODELS
# (switchable in the Ajustes tab). Consolidation must reliably fill numeric fields;
# gpt-4o-mini tends to leave them null, so the estimate node defaults to gpt-4o.
GRAPH_EXTRACTION_MODEL=gpt-4o-mini
GRAPH_GENERATION_MODEL=gpt-4o
# The graph's Postgres checkpointer reuses DATABASE_URL (its tables coexist with
# pgvector) — no separate connection string.
#
# Observability: set LOGFIRE_TOKEN to export one span per node to Pydantic Logfire
# (get a write token at https://logfire.pydantic.dev). With no token every span
# still runs locally but nothing is exported, so the service works either way.
# LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=estimator
